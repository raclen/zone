---
import { getCollection } from "astro:content";
import FuwariBlogLayout from "@/layouts/FuwariBlogLayout.astro";
import FuwariBentoCard from "@/components/fuwari/FuwariBentoCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import config from "@/config";

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

// 提取标签统计
const uniqueTags = getUniqueTags(posts);
const tagsWithCount = uniqueTags.map(tag => ({
  tag: tag.tag,
  count: posts.filter(p => p.data.tags?.includes(tag.tag)).length,
}));

// 提取年份统计
const yearsMap = new Map<string, number>();
sortedPosts.forEach(post => {
  const d = post.data.pubDatetime || post.data.modDatetime;
  if (d) {
    const year = new Date(d).getFullYear().toString();
    yearsMap.set(year, (yearsMap.get(year) || 0) + 1);
  }
});
const yearsList = Array.from(yearsMap.entries())
  .map(([year, count]) => ({ year, count }))
  .sort((a, b) => Number(b.year) - Number(a.year));
---

<FuwariBlogLayout
  title={`博客 | ${config.site.title}`}
  postsCount={sortedPosts.length}
  years={yearsList}
  tags={tagsWithCount}
  showBanner={false}
>
  <!-- 文章 Bento 卡片列表 -->
  <div class="space-y-4">
    {sortedPosts.map(post => (
      <FuwariBentoCard post={post} />
    ))}
  </div>

  <!-- 查看归档完整时间线引导 -->
  <div class="fuwari-card p-6 mt-6 text-center">
    <p class="text-sm text-muted-foreground mb-3">想要按时间倒叙查阅所有历年历史文章？</p>
    <a
      href="/archives"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-accent text-accent-foreground text-sm font-semibold hover:opacity-90 transition-opacity"
    >
      前往完整归档时间轴
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</FuwariBlogLayout>
