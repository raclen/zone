---
import { getCollection } from "astro:content";
import FuwariBlogLayout from "@/layouts/FuwariBlogLayout.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import config from "@/config";

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

// 统计标签
const uniqueTags = getUniqueTags(posts);
const tagsWithCount = uniqueTags.map(tag => ({
  tag: tag.tag,
  count: posts.filter(p => p.data.tags?.includes(tag.tag)).length,
}));

// 统计年份
const yearsMap = new Map<string, number>();
sortedPosts.forEach(post => {
  const d = post.data.pubDatetime || post.data.modDatetime;
  if (d) {
    const year = new Date(d).getFullYear().toString();
    yearsMap.set(year, (yearsMap.get(year) || 0) + 1);
  }
});
const yearsList = Array.from(yearsMap.entries())
  .map(([year, count]) => ({ year, count }))
  .sort((a, b) => Number(b.year) - Number(a.year));

const projects = [
  {
    title: "AnhePlayer",
    type: "Electron",
    description: "支持洛雪插件、自定义主题与歌词显示的跨平台音乐播放器。",
    href: "/anheplayer",
    linkText: "查看项目",
    featured: true,
  },
  {
    title: "OuterTune",
    type: "Android / Java",
    description: "采用 Material 3 界面的 Android 本地音乐播放器，支持洛雪音源。",
    href: "https://github.com/raclen/OuterTune",
    linkText: "查看源码",
    external: true,
  },
  {
    title: "WeChat Suite",
    type: "Python",
    description: "整理本地微信聊天记录，并使用大模型生成 Markdown 群聊日报。",
    href: "https://github.com/raclen/wechat-suite",
    linkText: "查看源码",
    external: true,
  },
  {
    title: "QQ Suite",
    type: "Python",
    description: "导出本地 NTQQ 聊天记录，用大模型生成 AI 日报与 Markdown/PNG 报告。",
    href: "https://github.com/raclen/qq-suite",
    linkText: "查看源码",
    external: true,
  },
  {
    title: "ETF 投资助手",
    type: "Next.js",
    description: "提供数据可视化、回测分析与策略参考的 ETF 投资组合工具。",
    href: "https://www.anhe-etf.bond",
    linkText: "访问网站",
    external: true,
  },
  {
    title: "issue-blog",
    type: "JavaScript",
    description: "使用 GitHub Issues 写文章，自动同步为 Markdown 并部署到 Cloudflare。",
    href: "https://github.com/raclen/issue-blog",
    linkText: "查看源码",
    external: true,
  },
];
---

<FuwariBlogLayout
  title={`作品 · ${config.site.title}`}
  description="Anhe 的个人作品与开源项目列表。"
  postsCount={sortedPosts.length}
  years={yearsList}
  tags={tagsWithCount}
  showBanner={false}
>
  <div class="space-y-4">
    <!-- 顶部介绍卡片 (对齐 Fuwari 卡片风格) -->
    <div class="fuwari-card p-5 sm:p-6 border border-border/80">
      <div class="flex items-center justify-between pb-3 border-b border-border/60 mb-4">
        <div class="flex items-center gap-2 font-bold text-base sm:text-lg text-foreground">
          <span class="w-1.5 h-4 rounded-full bg-accent"></span>
          <span>作品集 (Works)</span>
        </div>
        <span class="text-xs text-muted-foreground font-mono">
          收录 {projects.length} 个精选项目
        </span>
      </div>
      <p class="text-sm sm:text-base text-foreground/80 leading-relaxed">
        一些正在使用和持续维护的产品，也包括用于解决日常实际问题的小工具与开源实验。
      </p>
    </div>

    <!-- 作品列表网格 (2列响应式 Bento 卡片) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {projects.map((project) => (
        <article class="fuwari-card p-5 sm:p-6 border border-border/80 flex flex-col justify-between group hover:border-accent/40 transition-all duration-300">
          <div>
            <!-- 标签与状态 -->
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[11px] font-mono font-semibold px-2.5 py-0.5 rounded-full bg-accent/15 text-accent border border-accent/20">
                {project.type}
              </span>
              {project.featured && (
                <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-500 dark:text-amber-400">
                  Featured
                </span>
              )}
            </div>

            <!-- 标题 -->
            <h2 class="text-base sm:text-lg font-bold text-foreground group-hover:text-accent transition-colors mb-2">
              <a
                href={project.href}
                target={project.external ? "_blank" : undefined}
                rel={project.external ? "noopener noreferrer" : undefined}
                class="hover:underline"
              >
                {project.title}
              </a>
            </h2>

            <!-- 描述 -->
            <p class="text-xs sm:text-sm text-foreground/75 leading-relaxed line-clamp-3">
              {project.description}
            </p>
          </div>

          <!-- 底部链接与微动效按钮 -->
          <div class="pt-4 mt-4 border-t border-border/40 flex items-center justify-between">
            <a
              href={project.href}
              target={project.external ? "_blank" : undefined}
              rel={project.external ? "noopener noreferrer" : undefined}
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-accent hover:opacity-80 transition-opacity"
            >
              <span>{project.linkText}</span>
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                {project.external ? (
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                ) : (
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                )}
              </svg>
            </a>
          </div>
        </article>
      ))}

      <!-- 更多项目卡片 -->
      <aside class="fuwari-card p-5 sm:p-6 border border-border/80 border-dashed flex flex-col justify-between bg-muted/20">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="text-[11px] font-mono font-semibold px-2.5 py-0.5 rounded-full bg-muted text-muted-foreground">
              More
            </span>
          </div>
          <h2 class="text-base sm:text-lg font-bold text-foreground mb-2">更多探索</h2>
          <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
            新的项目构想和小工具都在持续整理中，欢迎前往 GitHub 交流探索。
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-border/40">
          <a
            href="https://github.com/raclen"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-muted-foreground hover:text-accent transition-colors"
          >
            <span>GitHub 个人主页</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </aside>
    </div>
  </div>
</FuwariBlogLayout>
