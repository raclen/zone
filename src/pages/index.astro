---
import AstroPaperLayout from "@/layouts/AstroPaperLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const projects = [
  {
    title: "AnhePlayer",
    type: "Electron",
    description: "支持洛雪插件、自定义主题与歌词显示的跨平台音乐播放器。",
    href: "/anheplayer",
    linkText: "查看项目",
  },
  {
    title: "OuterTune",
    type: "Android / Java",
    description: "采用 Material 3 界面的 Android 本地音乐播放器，支持洛雪音源。",
    href: "https://github.com/raclen/OuterTune",
    linkText: "查看源码",
    external: true,
  },
  {
    title: "WeChat Suite",
    type: "Python",
    description: "整理本地微信聊天记录，并使用大模型生成 Markdown 群聊日报。",
    href: "https://github.com/raclen/wechat-suite",
    linkText: "查看源码",
    external: true,
  },
  {
    title: "QQ Suite",
    type: "Python",
    description: "导出本地 NTQQ 聊天记录，用大模型生成 AI 日报与 Markdown/PNG 报告。",
    href: "https://github.com/raclen/qq-suite",
    linkText: "查看源码",
    external: true,
  },
  {
    title: "ETF 投资助手",
    type: "Next.js",
    description: "提供数据可视化、回测分析与策略参考的 ETF 投资组合工具。",
    href: "https://www.anhe-etf.bond",
    linkText: "访问网站",
    external: true,
  },
  {
    title: "issue-blog",
    type: "JavaScript",
    description: "使用 GitHub Issues 写文章，自动同步为 Markdown 并部署到 Cloudflare。",
    href: "https://github.com/raclen/issue-blog",
    linkText: "查看源码",
    external: true,
  },
  /*
  {
    title: "大模型 API 导航",
    type: "AI 工具",
    description: "按公益与收费分类整理常用大模型 API 服务与接口入口。",
    href: "/llm-api",
    linkText: "打开导航",
  },
  */
];
---

<AstroPaperLayout
  title="作品 · Anhe"
  description="Anhe 的个人作品与开发项目。"
>
  <Header />
  <main id="main-content" class="works-main">
      <section class="intro" aria-labelledby="page-title">
        <p class="kicker">Works</p>
        <h1 id="page-title">作品</h1>
        <p class="intro-copy">
          一些正在使用和持续维护的产品，也包括解决实际问题的小工具。
        </p>
      </section>

      <section class="project-grid" aria-label="作品列表">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-type">
              <span aria-hidden="true"></span>
              {project.type}
            </div>
            <h2>{project.title}</h2>
            <p>{project.description}</p>
            <a
              href={project.href}
              target={project.external ? "_blank" : undefined}
              rel={project.external ? "noopener noreferrer" : undefined}
            >
              {project.linkText}<span aria-hidden="true">{project.external ? " ↗" : " →"}</span>
            </a>
          </article>
        ))}

        <aside class="more-card">
          <p class="more-label">More</p>
          <h2>更多尝试</h2>
          <p>新的想法和小工具会陆续整理到这里。</p>
          <a href="https://github.com/raclen" target="_blank" rel="noopener noreferrer">
            GitHub ↗
          </a>
        </aside>
      </section>
  </main>
  <Footer />
</AstroPaperLayout>

<style>
  :global(:root) {
    --home-surface: rgba(255, 255, 255, 0.62);
    --home-text: var(--foreground);
    --home-muted: var(--muted-foreground);
    --home-border: var(--border);
    --home-accent: #b66a4f;
    --home-sage: #84927b;
  }

  .works-main {
    width: min(100% - 48px, var(--app-content-width));
    margin-inline: auto;
    padding-block: 88px 52px;
  }

  .intro {
    max-width: 660px;
    margin-inline: auto;
    text-align: center;
  }

  .kicker,
  .more-label {
    color: var(--home-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  h1,
  h2 {
    font-family: Georgia, "Songti SC", "SimSun", serif;
    font-weight: 400;
  }

  h1 {
    margin-top: 14px;
    font-size: 3rem;
    line-height: 1.15;
  }

  .intro-copy {
    max-width: 550px;
    margin: 22px auto 0;
    color: var(--home-muted);
    font-size: 1rem;
    line-height: 1.9;
  }

  .project-grid {
    margin-top: 64px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .project-card,
  .more-card {
    min-height: 264px;
    padding: 30px;
    border: 1px solid var(--home-border);
    border-radius: 8px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--home-surface);
    box-shadow: 0 18px 50px -44px rgba(37, 32, 26, 0.58);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: rgba(182, 106, 79, 0.32);
    box-shadow: 0 22px 52px -40px rgba(37, 32, 26, 0.65);
  }

  .project-type {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--home-muted);
    font-size: 0.8rem;
  }

  .project-type span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--home-sage);
  }

  .project-card h2,
  .more-card h2 {
    margin-top: 18px;
    font-size: 1.7rem;
    line-height: 1.25;
  }

  .project-card > p,
  .more-card > p:not(.more-label) {
    margin-top: 14px;
    color: var(--home-muted);
    font-size: 0.925rem;
    line-height: 1.75;
  }

  .project-card > a,
  .more-card > a {
    width: fit-content;
    margin-top: auto;
    padding-top: 22px;
    color: var(--home-text);
    font-size: 0.875rem;
    transition: color 160ms ease;
  }

  .project-card > a:hover,
  .more-card > a:hover {
    color: var(--home-accent);
  }

  .more-card {
    display: flex;
    flex-direction: column;
    border-style: dashed;
    background: rgba(255, 255, 255, 0.28);
  }

  @media (max-width: 680px) {
    .works-main {
      width: min(100% - 36px, var(--app-content-width));
    }

    .works-main {
      padding-block: 64px 40px;
    }

    h1 {
      font-size: 2.4rem;
    }

    .project-grid {
      grid-template-columns: 1fr;
      margin-top: 46px;
      gap: 18px;
    }

    .project-card,
    .more-card {
      min-height: 238px;
      padding: 26px;
    }
  }

  :global([data-theme="dark"]) {
      --home-surface: rgba(43, 41, 37, 0.72);
      --home-accent: #d58b6d;
      --home-sage: #98a68f;
  }

  :global([data-theme="dark"]) .more-card {
    background: rgba(255, 255, 255, 0.018);
  }
</style>
