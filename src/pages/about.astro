---
import { getCollection } from "astro:content";
import FuwariBlogLayout from "@/layouts/FuwariBlogLayout.astro";
import SeoJsonLd from "@/components/SeoJsonLd.astro";
import { FRIEND_LINKS } from "@/data/friends";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTagsWithCount } from "@/utils/getUniqueTags";
import config from "@/config";

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

// 统计标签
const tagsWithCount = getUniqueTagsWithCount(posts);

// 统计年份
const yearsMap = new Map<string, number>();
sortedPosts.forEach(post => {
  const d = post.data.pubDatetime || post.data.modDatetime;
  if (d) {
    const year = new Date(d).getFullYear().toString();
    yearsMap.set(year, (yearsMap.get(year) || 0) + 1);
  }
});
const yearsList = Array.from(yearsMap.entries())
  .map(([year, count]) => ({ year, count }))
  .sort((a, b) => Number(b.year) - Number(a.year));
---

<FuwariBlogLayout
  title={`关于我 | ${config.site.title}`}
  description="关于 Anhe：个人经历、工作与技术生活记录。"
  postsCount={sortedPosts.length}
  years={yearsList}
  tags={tagsWithCount}
  showBanner={false}
>
  <SeoJsonLd
    slot="head"
    type="Person"
    title={`关于我 | ${config.site.title}`}
    description="关于 Anhe：个人经历、工作与技术生活记录。"
    url={`${config.site.url.replace(/\/$/, "")}/about/`}
  />
  <div class="space-y-4">
    <!-- 关于我 - 主卡片 -->
    <article class="fuwari-card p-6 sm:p-8 border border-border/80">
      <!-- 头部标题 -->
      <div class="flex items-center justify-between pb-4 mb-6 border-b border-border/60">
        <div class="flex items-center gap-2 font-bold text-base sm:text-lg text-foreground">
          <span class="w-1.5 h-4 rounded-full bg-accent"></span>
          <span>关于我</span>
        </div>
        <span class="text-xs text-muted-foreground font-mono">
          Anhe / Developer
        </span>
      </div>

      <!-- 正文内容：时间线式段落卡片 -->
      <div class="space-y-6 text-sm sm:text-base leading-relaxed text-foreground/85">
        <!-- 过去 -->
        <div class="p-4 sm:p-5 rounded-xl bg-muted/40 border border-border/50">
          <div class="flex items-center gap-2 font-bold text-accent mb-2">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span class="text-sm font-mono uppercase tracking-wider">过去</span>
          </div>
          <p class="text-foreground/80 leading-relaxed">
            计算机专业，在上海携程工作十年，长期从事前端开发和管理。
          </p>
        </div>

        <!-- 现在 -->
        <div class="p-4 sm:p-5 rounded-xl bg-muted/40 border border-border/50">
          <div class="flex items-center gap-2 font-bold text-accent mb-2">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span class="text-sm font-mono uppercase tracking-wider">现在</span>
          </div>
          <p class="text-foreground/80 leading-relaxed">
            回到三线城市，在家带娃，抽空写点实用、有趣的产品和小工具。
          </p>
        </div>

        <!-- 未来 -->
        <div class="p-4 sm:p-5 rounded-xl bg-muted/40 border border-border/50">
          <div class="flex items-center gap-2 font-bold text-accent mb-2">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span class="text-sm font-mono uppercase tracking-wider">未来</span>
          </div>
          <p class="text-muted-foreground leading-relaxed">
            想好了，再补充...
          </p>
        </div>
      </div>

      <!-- 签名与联系方式 -->
      <div class="mt-8 pt-6 border-t border-border/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs sm:text-sm text-muted-foreground font-mono">
        <div class="flex items-center gap-3">
          <span class="font-bold text-foreground">raclen</span>
          <span>•</span>
          <span class="email-text" data-user="muxu.jiu" data-domain="gmail.com">muxu.jiu [at] gmail.com</span>
        </div>
        <div>
          <span>© {new Date().getFullYear()} All rights reserved.</span>
        </div>
      </div>
    </article>

    <!-- 友情链接：放在关于我卡片下方 -->
    <article class="fuwari-card p-4 sm:p-5 border border-border/80">
      <div class="flex items-center justify-between pb-3 mb-3 border-b border-border/60">
        <div class="flex items-center gap-2 font-bold text-sm text-foreground">
          <span class="w-1.5 h-3.5 rounded-full bg-accent"></span>
          <span>友情链接</span>
        </div>
        <span class="text-xs text-muted-foreground font-mono">
          共收录 {FRIEND_LINKS.length} 位朋友
        </span>
      </div>

      {
        FRIEND_LINKS.length === 0 && (
          <div class="py-4 text-center text-sm text-muted-foreground">
            暂时还没有友链，欢迎来做第一位朋友～
          </div>
        )
      }

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
        {
          FRIEND_LINKS.map(friend => (
            <a
              href={friend.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group block pb-3 border-b border-border/60 hover:border-accent/60 transition-all"
            >
              <div class="flex items-center gap-3">
                <img
                  src={friend.image}
                  alt={friend.title}
                  loading="lazy"
                  class="w-10 h-10 rounded-full object-cover shrink-0 border border-border/60 group-hover:border-accent group-hover:scale-105 transition-all shadow-xs"
                  onerror="this.onerror=null; this.src='/favicon.svg';"
                />
                <div class="min-w-0 flex-1">
                  <div class="font-bold text-sm text-foreground group-hover:text-accent transition-colors truncate">
                    {friend.title}
                  </div>
                  <div class="text-xs text-muted-foreground line-clamp-1 mt-0.5 leading-relaxed">
                    {friend.intro}
                  </div>
                </div>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-4 pt-3 border-t border-border/60 text-xs text-muted-foreground leading-relaxed">
        <p>💡 申请友链：欢迎志同道合、热爱技术与生活的朋友交换友链，可在 Issue 或关于我中的邮箱联系～</p>
      </div>
    </article>
  </div>

  <script is:inline>
    document.querySelectorAll(".email-text[data-user][data-domain]").forEach((el) => {
      const user = el.getAttribute("data-user");
      const domain = el.getAttribute("data-domain");
      if (!user || !domain) return;

      const email = `${user}@${domain}`;
      const link = document.createElement("a");
      link.href = `mailto:${email}`;
      link.textContent = email;
      link.rel = "nofollow";
      link.className = "text-accent hover:underline";

      el.replaceChildren(link);
    });
  </script>
</FuwariBlogLayout>
