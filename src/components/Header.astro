---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import FuwariSearchModal from "./fuwari/FuwariSearchModal.astro";
import config from "@/config";

const { site } = config;
const locale = Astro.currentLocale ?? config.site.lang;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === "/" && (currentPath === "/" || currentPath === "")) return true;
  if (path === "/blog" && (currentPath === "/blog" || currentPath === "/blog/")) return true;
  if (path === "/archives" && currentPath.startsWith("/archives")) return true;
  if (path === "/about" && currentPath.startsWith("/about")) return true;
  return false;
};
---

<!-- 顶部常规导航栏 (自然随页面滚动，不吸顶) -->
<header class="relative z-40 w-full transition-all duration-300">
  <div class="max-w-[75rem] mx-auto px-4 sm:px-6 w-full pt-2 sm:pt-3">
    <div
      class="fuwari-card !rounded-2xl h-14 sm:h-16 px-3 sm:px-5 flex items-center justify-between shadow-sm bg-background/80 backdrop-blur-md border border-border/80"
    >
      <!-- 左侧站点 Logo / 标题 -->
      <a
        href={getRelativeLocaleUrl(locale, "blog")}
        class="flex items-center gap-2 font-bold text-base sm:text-lg text-foreground hover:text-accent transition-colors shrink-0 group px-2 py-1.5 rounded-lg"
      >
        <div class="w-8 h-8 rounded-xl bg-accent/15 flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-accent-foreground transition-all">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z"/>
          </svg>
        </div>
        <span class="tracking-tight">{site.title}</span>
      </a>

      <!-- 中间菜单导航项（大屏展示，圆角悬浮背景态） -->
      <nav class="hidden md:flex items-center gap-1 sm:gap-2">
        <a
          href={getRelativeLocaleUrl(locale, "")}
          class:list={[
            "px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition-all",
            isActive("/")
              ? "bg-accent text-accent-foreground shadow-sm"
              : "text-foreground/75 hover:text-foreground hover:bg-muted/80"
          ]}
        >
          作品
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "blog")}
          class:list={[
            "px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition-all",
            isActive("/blog")
              ? "bg-accent text-accent-foreground shadow-sm"
              : "text-foreground/75 hover:text-foreground hover:bg-muted/80"
          ]}
        >
          博客
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "archives")}
          class:list={[
            "px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition-all",
            isActive("/archives")
              ? "bg-accent text-accent-foreground shadow-sm"
              : "text-foreground/75 hover:text-foreground hover:bg-muted/80"
          ]}
        >
          归档
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "about")}
          class:list={[
            "px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition-all",
            isActive("/about")
              ? "bg-accent text-accent-foreground shadow-sm"
              : "text-foreground/75 hover:text-foreground hover:bg-muted/80"
          ]}
        >
          关于
        </a>
      </nav>

      <!-- 右侧操作工具栏：搜索呼出、明暗主题切换、移动端汉堡菜单 -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <!-- 搜索按钮（对标 Fuwari Search 触发器） -->
        <button
          type="button"
          data-open-search
          class="w-9 h-9 rounded-xl flex items-center justify-center text-foreground/75 hover:text-accent hover:bg-accent/10 transition-colors"
          title="搜索 (Ctrl+K)"
          aria-label="搜索全站文章"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <!-- 暗黑模式切换按钮 -->
        <button
          id="theme-toggle-btn"
          type="button"
          class="w-9 h-9 rounded-xl flex items-center justify-center text-foreground/75 hover:text-accent hover:bg-accent/10 transition-colors"
          title="切换日夜模式"
          aria-label="切换明暗主题"
        >
          <IconSunHigh class="w-4 h-4 hidden dark:block" />
          <IconMoon class="w-4 h-4 block dark:hidden" />
        </button>

        <!-- 移动端展开抽屉按钮 -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="md:hidden w-9 h-9 rounded-xl flex items-center justify-center text-foreground/75 hover:text-accent hover:bg-accent/10 transition-colors"
          title="展开导航菜单"
          aria-label="移动端菜单"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- 移动端展开悬浮面板 -->
    <div
      id="mobile-menu-panel"
      class="hidden md:hidden fuwari-card mt-2 p-3 bg-background/95 backdrop-blur-md border border-border shadow-lg"
    >
      <div class="flex flex-col gap-1 text-sm font-semibold">
        <a href={getRelativeLocaleUrl(locale, "")} class="px-3 py-2 rounded-lg hover:bg-muted/80">作品</a>
        <a href={getRelativeLocaleUrl(locale, "blog")} class="px-3 py-2 rounded-lg hover:bg-muted/80">博客</a>
        <a href={getRelativeLocaleUrl(locale, "archives")} class="px-3 py-2 rounded-lg hover:bg-muted/80">归档</a>
        <a href={getRelativeLocaleUrl(locale, "about")} class="px-3 py-2 rounded-lg hover:bg-muted/80">关于</a>
      </div>
    </div>
  </div>
</header>

<!-- 全局搜索 Modal 浮层挂载 -->
<FuwariSearchModal />

<script>
  function setupHeader() {
    // 移动端菜单切换
    const menuBtn = document.getElementById("mobile-menu-toggle");
    const menuPanel = document.getElementById("mobile-menu-panel");
    menuBtn?.addEventListener("click", () => {
      menuPanel?.classList.toggle("hidden");
    });

    // 主题切换
    const themeBtn = document.getElementById("theme-toggle-btn");
    themeBtn?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");
      const nextTheme = isDark ? "light" : "dark";
      document.documentElement.classList.toggle("dark", !isDark);
      document.documentElement.setAttribute("data-theme", nextTheme);
      localStorage.setItem("theme", nextTheme);
    });
  }

  document.addEventListener("astro:page-load", setupHeader);
  setupHeader();
</script>
